          "enum": [
            "abort"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "failed",
            "aborted",
            "timedout",
            "accessdenied",
            "connectionclosed",
            "connectionreset",
            "connectionrefused",
            "connectionaborted",
            "connectionfailed",
            "namenotresolved",
            "internetdisconnected",
            "addressunreachable",
