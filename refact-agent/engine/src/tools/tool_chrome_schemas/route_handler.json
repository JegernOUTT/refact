        },
        "path": {
          "type": "string",
          "description": "Response body file; relative paths resolve inside the runtime artifact directory and may not escape it; content type is inferred from the extension"
        },
        "json": {
          "description": "Response body serialized as application/json"
        },
        "body_base64": {
          "type": "boolean",
          "description": "Treat body as base64 binary bytes"
