{
  "type": "object",
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "type": "string",
      "description": "",
      "enum": []
    },
    "topic": {
      "type": "string",
      "description": "help section; omitted returns the index plus the overview"
    },
    "url": {
      "type": "string",
      "description": "navigate and open_tab URL, or the asset URL for add_script_tag and add_style_tag"
    },
    "device": {
      "type": "string",
      "enum": [
        "desktop",
        "mobile",
        "tablet"
      ]
    },
    "tab": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "active",
            "id"
          ]
        },
        "id": {
          "type": "string",
          "description": "Required when type is id"
        }
      }
    },
    "locator": {},
    "source": {
      "type": "object",
      "description": "drag_and_drop source element; same shape as `locator`"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "description": "drop target element; same shape as `locator`"
        },
        {
          "type": "string",
          "enum": [
            "page",
            "browser"
          ],
          "description": "cdp_send target, page by default"
        }
      ]
    },
    "source_position": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "target_position": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "text": {
      "type": "string",
      "description": "Text to fill, insert, type, wait for, or annotate with"
    },
    "key": {
      "type": "string",
      "description": "Key name for press_key, such as Enter, Escape, or ArrowDown"
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Alt",
          "Ctrl",
          "Meta",
          "Shift"
        ]
      },
      "description": "Modifier keys held during press_key"
    },
    "expression": {
      "type": "string",
      "description": "JavaScript for eval, wait_for_function, and expect_poll"
    },
    "selector": {
      "type": "string",
      "description": "CSS selector for dom_snapshot"
    },
    "value": {
      "type": "string",
      "description": "select_option value; locator values live inside locator"
    },
    "attribute": {
      "type": "string",
      "description": "Attribute name read by get_attribute"
    },
    "seconds": {
      "type": "number",
      "description": "Fixed delay for wait_seconds; never use it for readiness"
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "start_x": {
      "type": "number"
    },
    "start_y": {
      "type": "number"
    },
    "end_x": {
      "type": "number"
    },
    "end_y": {
      "type": "number"
    },
    "delta_x": {
      "type": "number"
    },
    "delta_y": {
      "type": "number"
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "description": "mouse_move interpolation steps; defaults to 1"
    },
    "button": {
      "type": "string",
      "enum": [
        "left",
        "middle",
        "right"
      ]
    },
    "click_count": {
      "type": "integer",
      "minimum": 1
    },
    "delay": {
      "type": "integer",
      "minimum": 0,
      "description": "mouse_click_xy hold time in ms between press and release"
    },
    "delay_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "press_sequentially per-character delay in ms; defaults to 0"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Timeout in ms (waits/navigate/expect/click/hover default 5000; eval 30000)"
    },
    "ticks": {
      "oneOf": [
        {
          "type": "integer",
          "description": "Milliseconds to advance the clock by"
        },
        {
          "type": "string",
          "description": "Human-readable duration: \"08\", \"01:00\" or \"02:34:10\""
        }
      ]
    },
    "time": {
      "oneOf": [
        {
          "type": "integer",
          "description": "Unix time in milliseconds"
        },
        {
          "type": "string",
          "description": "ISO date or date-time, for example \"2020-02-02\" or \"2020-02-02T10:00:00Z\""
        }
      ]
    },
    "matcher": {
      "description": "Matcher for expect (object) or expect_poll (comparator name).",
      "oneOf": [
        {
          "type": "object",
          "description": "type plus expected/name/ignore_case; text accepts a string, a {source,flags} regex, or an array of them",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "to_be_attached",
                "to_be_visible",
                "to_be_hidden",
                "to_be_enabled",
                "to_be_disabled",
                "to_be_editable",
                "to_be_checked",
                "to_be_focused",
                "to_be_empty",
                "to_be_in_viewport",
                "to_have_text",
                "to_contain_text",
                "to_have_value",
                "to_have_values",
                "to_have_attribute",
                "to_have_class",
                "to_contain_class",
                "to_have_count",
                "to_have_css",
                "to_have_id",
                "to_have_js_property",
                "to_have_role",
                "to_have_accessible_name",
                "to_have_accessible_description",
                "to_have_url",
                "to_have_title",
                "to_match_aria_snapshot"
              ]
            },
            "expected": {},
            "name": {
              "type": "string"
            },
            "ignore_case": {
              "type": "boolean"
            },
            "checked": {
              "type": "boolean",
              "description": "to_be_checked state; defaults to true"
            },
            "indeterminate": {
              "type": "boolean",
              "description": "to_be_checked mixed state; excludes checked"
            },
            "pseudo": {
              "type": "string",
              "enum": [
                "before",
                "after"
              ],
              "description": "to_have_css pseudo-element"
            },
            "ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "to_be_in_viewport minimum intersection ratio"
            }
          }
        },
        {
          "type": "string",
          "description": "expect_poll comparator against `expected`",
          "enum": [
            "equals",
            "contains",
            "gt",
            "lt",
            "matches_regex"
          ]
        }
      ]
    },
    "expected": {
      "description": "expect_poll expected value; matches_regex takes a regex string or {source,flags}"
    },
    "polling_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "wait_for_function poll interval; defaults to 100/250/500/1000ms repeating the last"
    },
    "soft": {
      "type": "boolean",
      "description": "Record assertion failure and continue the batch"
    },
    "not": {
      "type": "boolean",
      "description": "Invert the expect matcher and retry until it stops matching"
    },
    "limit": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum rows or matches returned; omitted returns all"
    },
    "clear_first": {
      "type": "boolean",
      "description": "Defaults to true"
    },
    "verify": {
      "type": "boolean",
      "description": "Defaults to true for fill and clear"
    },
    "js": {
      "type": "boolean",
      "description": "start_coverage JavaScript coverage; defaults to true"
    },
    "css": {
      "type": "boolean",
      "description": "start_coverage CSS coverage; defaults to true"
    },
    "reset_on_navigation": {
      "type": "boolean",
      "description": "Reset coverage on navigation; defaults to true"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "description": "capture_frames burst length; defaults to 1000ms"
    },
    "frame_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 24,
      "description": "capture_frames frame count; defaults to 8, excludes interval_ms"
    },
    "interval_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "capture_frames spacing; excludes frame_count"
    },
    "compose": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "grid",
            "separate"
          ]
        }
      ],
      "description": "screencast_stop: compose a filmstrip (default true). screenshot_elements: grid = one labeled sheet, separate = one image each"
    },
    "max_width": {
      "type": "integer",
      "minimum": 1,
      "description": "screencast_start frame width cap"
    },
    "max_height": {
      "type": "integer",
      "minimum": 1,
      "description": "screencast_start frame height cap"
    },
    "protocol": {
      "type": "string",
      "enum": [
        "u2f",
        "ctap2"
      ]
    },
    "transport": {
      "type": "string",
      "enum": [
        "usb",
        "nfc",
        "ble",
        "cable",
        "internal"
      ]
    },
    "has_resident_key": {
      "type": "boolean"
    },
    "has_user_verification": {
      "type": "boolean"
    },
    "is_user_verified": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "description": "Server-minted id from add_virtual_authenticator or add_init_script; sending it to the minting action is an error"
    },
    "credential": {
      "type": "object",
      "required": [
        "credential_id",
        "private_key"
      ],
      "properties": {
        "credential_id": {
          "type": "string"
        },
        "is_resident_credential": {
          "type": "boolean"
        },
        "rp_id": {
          "type": "string"
        },
        "private_key": {
          "type": "string"
        },
        "user_handle": {
          "type": "string"
        },
        "sign_count": {
          "type": "integer",
          "minimum": 0
        },
        "large_blob": {
          "type": "string"
        },
        "backup_eligibility": {
          "type": "boolean"
        },
        "backup_state": {
          "type": "boolean"
        },
        "user_name": {
          "type": "string"
        },
        "user_display_name": {
          "type": "string"
        }
      }
    },
    "max_chars": {
      "type": "integer",
      "minimum": 0,
      "description": "dom_snapshot and accessibility_snapshot character cap"
    },
    "property_filter": {
      "type": "string",
      "description": "case-sensitive substring test against each `property: value` line"
    },
    "mode": {
      "type": "string",
      "enum": [
        "ai",
        "default",
        "inner_text",
        "text_content"
      ],
      "description": "accessibility_snapshot ai (default) or default; all_texts inner_text (default) or text_content"
    },
    "refs": {
      "type": "boolean",
      "description": "Mint refs in accessibility_snapshot; defaults to true in ai mode"
    },
    "boxes": {
      "type": "boolean",
      "description": "Include element boxes in accessibility_snapshot"
    },
    "depth": {
      "type": "integer",
      "minimum": 1,
      "description": "Limit accessibility_snapshot nesting; deeper children collapse to a count marker"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Absolute paths for set_input_files, drop_files, expect_file_chooser"
    },
    "state": {
      "type": "string",
      "enum": [
        "domcontentloaded",
        "load",
        "networkidle",
        "attached",
        "detached",
        "visible",
        "hidden"
      ],
      "description": "wait_for_load_state load state, or wait_for_selector element state (attached by default)"
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599,
      "description": "Response status filter for wait_for_response"
    },
    "contains": {
      "type": "string",
      "description": "Substring filter for wait_for_console_message"
    },
    "level": {
      "type": "string",
      "enum": [
        "log",
        "warning",
        "error"
      ],
      "description": "Level filter for wait_for_console_message"
    },
    "wait_until": {
      "type": "string",
      "enum": [
        "domcontentloaded",
        "load",
        "networkidle"
      ],
      "description": "Load state set_content waits for; defaults to load"
    },
    "html": {
      "type": "string",
      "description": "Raw document HTML for set_content"
    },
    "content": {
      "type": "string",
      "description": "Inline source for add_script_tag, add_style_tag, add_init_script; excludes url"
    },
    "script_type": {
      "type": "string",
      "description": "add_script_tag type attribute, for example module"
    },
    "event_type": {
      "type": "string",
      "description": "dispatch_event DOM event name; the class is inferred from it"
    },
    "event_init": {
      "type": "object",
      "description": "dispatch_event init; bubbles, cancelable, composed default to true"
    },
    "pattern": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "flags": {
              "type": "string"
            }
          }
        }
      ],
      "description": "Glob or {source,flags} regex; wait_for_url reads plain text as a substring"
    },
    "aggressive": {
      "type": "boolean",
      "description": "dismiss_overlays: also delete large fixed overlays, not just click dismiss buttons"
    },
    "save_as": {
      "type": "string",
      "description": "Artifact file name for storage_state and wait_for_download"
    },
    "full_page": {
      "type": "boolean",
      "description": "Capture the whole scrollable page instead of the viewport"
    },
    "clip": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "png",
        "jpeg",
        "webp"
      ]
    },
    "quality": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "JPEG or WebP quality 0-100; ignored for png"
    },
    "scale": {
      "description": "Screenshot scale css|device, or numeric PDF scale 0.1-2",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "css",
            "device"
          ]
        },
        {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2.0
        }
      ]
    },
    "omit_background": {
      "type": "boolean"
    },
    "animations": {
      "type": "string",
      "enum": [
        "allow",
        "disabled"
      ]
    },
    "caret": {
      "type": "string",
      "enum": [
        "hide",
        "initial"
      ]
    },
    "mask": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "masked element; same shape as `locator`"
      }
    },
    "mask_color": {
      "type": "string"
    },
    "style": {
      "type": "string",
      "description": "highlight inline CSS, or an extra screenshot stylesheet"
    },
    "locators": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "captured element; same shape as `locator`"
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "default",
          "hover",
          "focus",
          "active"
        ]
      }
    },
    "labels": {
      "type": "boolean"
    },
    "label": {
      "type": "string",
      "description": "Text label drawn by highlight"
    },
    "landscape": {
      "type": "boolean"
    },
    "print_background": {
      "type": "boolean"
    },
    "format": {
      "type": "string",
      "enum": [
        "Letter",
        "Legal",
        "Tabloid",
        "Ledger",
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "A5",
        "A6"
      ]
    },
    "margins": {
      "type": "object",
      "properties": {
        "top": {
          "type": "string"
        },
        "right": {
          "type": "string"
        },
        "bottom": {
          "type": "string"
        },
        "left": {
          "type": "string"
        }
      }
    },
    "page_ranges": {
      "type": "string"
    },
    "prefer_css_page_size": {
      "type": "boolean"
    },
    "tagged": {
      "type": "boolean"
    },
    "outline": {
      "type": "boolean"
    },
    "width": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string"
        }
      ],
      "description": "pixels (set_viewport/set_window_bounds) or a CSS length (pdf)"
    },
    "height": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string"
        }
      ],
      "description": "pixels (set_viewport/set_window_bounds) or a CSS length (pdf)"
    },
    "device_scale_factor": {
      "type": "number",
      "minimum": 0
    },
    "is_mobile": {
      "type": "boolean"
    },
    "has_touch": {
      "type": "boolean"
    },
    "color_scheme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "no-preference"
      ]
    },
    "reduced_motion": {
      "type": "string",
      "enum": [
        "reduce",
        "no-preference"
      ]
    },
    "forced_colors": {
      "type": "string",
      "enum": [
        "active",
        "none"
      ]
    },
    "contrast": {
      "type": "string",
      "enum": [
        "more",
        "less",
        "custom",
        "no-preference"
      ]
    },
    "media": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "accept_language": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "accuracy": {
      "type": "number",
      "minimum": 0
    },
    "offline": {
      "type": "boolean"
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "method": {
      "type": "string",
      "description": "http_request method (GET by default), wait_for_request and wait_for_response filter, or cdp_send CDP method"
    },
    "params": {
      "type": "object",
      "description": "cdp_send CDP parameters, omitted when the method takes none"
    },
    "body": {
      "type": "string",
      "description": "Raw http_request body; mutually exclusive with body_json and form"
    },
    "body_json": {
      "description": "http_request JSON body, sent as application/json"
    },
    "form": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "http_request form fields, sent as application/x-www-form-urlencoded"
    },
    "max_redirects": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "fail_on_status": {
      "type": "boolean",
      "description": "Fail http_request when the status is not 2xx"
    },
    "full_headers": {
      "type": "boolean",
      "description": "Return all http_request response headers, not just content-type and content-length"
    },
    "urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cookies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "domain": {
      "type": "string"
    },
    "path": {
      "type": "string",
      "description": "route_from_har, HAR recording, and cookie path filters"
    },
    "kind": {
      "type": "string",
      "enum": [
        "local",
        "session"
      ]
    },
    "origin": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {},
          "value": {}
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "username": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Locator handler, device, cookie, or matcher property name"
    },
    "times": {
      "type": "integer",
      "minimum": 1,
      "description": "Expire a route or locator handler after this many matches"
    },
    "no_wait_after": {
      "type": "boolean"
    },
    "accept": {
      "type": "boolean",
      "description": "handle_dialog: true accepts, false dismisses"
    },
    "prompt_text": {
      "type": "string"
    },
    "handler": {}
  }
}
