schema_version: 2
id: my_custom_subagent
title: My Custom Subagent
description: Example of a user-defined subagent tool
expose_as_tool: true
has_code: false

tool:
  description: A custom subagent that performs specialized analysis
  agentic: true
  parameters:
    - name: query
      type: string
      description: The query or task to analyze
    - name: context
      type: string
      description: Additional context for the analysis
  required:
    - query

subchat:
  stateful: false
  model_type: default
  n_ctx: 100000
  max_new_tokens: 8000
  temperature: 0.3

messages:
  system_prompt: |
    You are a specialized analysis agent. Your job is to provide thorough,
    well-structured analysis based on the query provided.

    Guidelines:
    - Be thorough but focused
    - Use available tools to gather information
    - Provide clear, actionable insights
    - Structure your response with clear sections

  user_template: |
    # Analysis Request

    **Query:** {{query}}

    {{#if context}}
    **Context:** {{context}}
    {{/if}}

    Please perform a comprehensive analysis and provide your findings.

tools:
  - tree
  - cat
  - glob
  - search_pattern
  - search_semantic
  - knowledge

# Optional reusable agent profile. Referenced by `subagent(profile: "my_custom_subagent")`
# or `subagent(profile: {name: "my_custom_subagent", revision: <revision>})` to pin an
# exact revision. The revision is derived from this block's content, so editing it never
# changes a launch that was already accepted.
#
# A profile supplies defaults only. A run instance may narrow them and can never widen
# them: tools are intersected with the caller's concrete tool ceiling and anything outside
# it is dropped with an explicit note, never granted.
agent_profile:
  model_type: default
  tools:
    - cat
    - glob
  deny_tools:
    - shell
  role: Read-only analyst that never edits files
  skills:
    - static analysis
  reasoning_effort: high
  hooks:
    - report findings before finishing
  path_scope:
    - src/lib.rs
  approval:
    autonomous_no_confirm: false
    auto_approve_editing_tools: false
    auto_approve_dangerous_commands: false
